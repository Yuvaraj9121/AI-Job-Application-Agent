DATABASE_PATH=data/jobs.db
MIN_MATCHED_SKILLS=2
AUTONOMOUS_MODE=false
MAX_APPLICATIONS_PER_RUN=10
MAX_APPLICATIONS_PER_DAY=25

# Optional: enables live web-search results from LinkedIn/Naukri/Indeed/company career pages.
# Get an API key from Tavily and set it locally; never commit the key.
TAVILY_API_KEY=
